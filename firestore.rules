rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Les documents de transfert ne sont manipulés que par l'Admin SDK
    // depuis les Cloud Functions, jamais directement par le client.
    match /transfers/{transferId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
