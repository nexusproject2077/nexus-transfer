# Configuration Firebase côté front (Vite).
# Copie ce fichier en `.env` puis renseigne les valeurs de ton projet
# (Console Firebase → Paramètres du projet → Tes applications → SDK Web).
# Le fichier `.env` est gitignoré : ne commit jamais tes vraies clés.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nexus-transfer.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nexus-transfer

# ⚠️ Nom exact du bucket : `.firebasestorage.app`, PAS `.appspot.com`.
VITE_FIREBASE_STORAGE_BUCKET=nexus-transfer.firebasestorage.app

VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
