rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} {
      // Lecture impossible depuis le client : tout passe par une URL signée
      // générée par la Cloud Function downloadTransfer.
      allow read: if false;

      // Écriture réservée aux sessions authentifiées (auth anonyme suffit),
      // avec un plafond de taille strict par fichier.
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
